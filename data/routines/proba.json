    {"origin": "link", "paths": {"1": [
      {"kind": "line", "to": [0, 10], "nose": 90, "seconds": 3}
    ]}},
    {"origin": "own", "paths": {"1": [
      {"kind": "line", "to": [0, 60], "nose": 90, "seconds": 5},
      {"kind": "rotate", "degrees": 90, "direction": "ccw", "about": "center", "seconds": 1.5},
      {"kind": "mark", "mark": "stall", "nose": 0, "seconds": 2},
