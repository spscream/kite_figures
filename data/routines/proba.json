    {"origin": "own", "paths": {"1": [
      {"kind": "line", "to": [-60, 50], "seconds": 4},
      {"kind": "mark", "mark": "stall", "nose": 0, "seconds": 2},
      {"kind": "arc", "to": [-30, 50], "center": [-45, 50], "direction": "cw", "sweep": 180, "nose": 0, "seconds": 5}
    ]}},
    {"origin": "link", "paths": {"1": [
      {"kind": "line", "to": [-30, 10], "nose": 0, "seconds": 4}
    ]}},
