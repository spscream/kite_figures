{
  "name": "kite-figures",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:automerge": "python3 -m unittest discover -s scripts/tests -t .",
    "check:export": "node scripts/check-export.mjs",
    "gate": "npm run lint && npm run typecheck && npm run test && npm run test:automerge && npm run build && npm run check:export"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
